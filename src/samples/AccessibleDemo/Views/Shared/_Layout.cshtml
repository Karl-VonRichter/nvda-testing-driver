<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Accessible Demo</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
	<a class="visually-hidden-focusable" href="#main-content">Skip to main content</a>
	<nav aria-label="Main navigation" class="container py-3 border-bottom">
		<ul class="nav gap-2">
			<li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
			<li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
			<li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="TreeViewExample">Accessible tree view</a></li>
		</ul>
	</nav>
	<div class="container py-4">
		<main id="main-content" tabindex="-1">@RenderBody()</main>
		<hr />
		<footer>
			<p>NVDA Testing Driver — Local example</p>
		</footer>
	</div>
	<script src="~/lib/jquery/dist/jquery.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@RenderSection("Scripts", required: false)
</body>
</html>
