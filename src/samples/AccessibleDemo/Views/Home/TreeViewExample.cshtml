@using AccessibleDemo.Models
@using System.Text
@using System.Text.Encodings.Web
@model AccessibleDemo.Models.TreeViewViewModel
@{
	ViewData["Title"] = "Tree View Example";
}

<h1>WCAG 2.1</h1>
<p><a id="lnkWcag" href="https://www.w3.org/TR/WCAG21/">Go to WCAG 2.1 page</a></p>
<div class="treeview">
	<ul class="tree" role="tree" aria-label="All WCAG 2.1 elements">
		@foreach (var item in Model.Items)
		{
			@Html.Raw(RenderItem(item))
		}
	</ul>
</div>
@section  scripts
{
	<script src="~/js/TreeView.js"></script>
}

@functions
{
string RenderItem(TreeViewItemViewModel item)
{
	StringBuilder str = new StringBuilder();
	str.AppendLine($"<li role=\"presentation\" data-value=\"{HtmlEncoder.Default.Encode(item.Value)}\"><a role=\"treeitem\" " +
		(item.Children != null && item.Children.Any() ? "aria-expanded=\"false\" " : "") +
		(item.Value == Model.SelectedItem ? "tabindex=\"0\" aria-selected=\"true\" " : "") +
		$"href=\"#\">{HtmlEncoder.Default.Encode(item.Text)}</a>");
	if (item.Children != null && item.Children.Any())
	{
		str.AppendLine("<ul role=\"group\" class=\"children\" style=\"display:none\">");
		foreach (var subItem in item.Children)
		{
			str.Append(RenderItem(subItem));
		}
		str.AppendLine("</ul>");
	}
	str.AppendLine("</li>");
	return str.ToString();
}
}
