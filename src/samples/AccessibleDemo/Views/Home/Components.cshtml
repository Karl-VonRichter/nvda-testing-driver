@{
	ViewData["Title"] = "Accessible components";
}
<h1>Accessible components</h1>
<section aria-labelledby="form-heading">
	<h2 id="form-heading">Example form</h2>
	<form id="example-form" novalidate>
		<label for="example-email">Email</label>
		<input id="example-email" type="email" required aria-describedby="email-help" />
		<p id="email-help">Enter an email address for this local example.</p>
		<button type="submit">Submit example</button>
		<p id="form-result" role="alert"></p>
	</form>
</section>
<section aria-labelledby="table-heading">
	<h2 id="table-heading">Example table</h2>
	<table>
		<caption>Example inventory</caption>
		<thead><tr><th scope="col">Item</th><th scope="col">Quantity</th></tr></thead>
		<tbody>
			<tr><th scope="row">Pencils</th><td>12</td></tr>
			<tr><th scope="row">Notebooks</th><td>5</td></tr>
		</tbody>
	</table>
</section>
<section aria-labelledby="dialog-heading">
	<h2 id="dialog-heading">Example dialog</h2>
	<button id="open-dialog" type="button">Open example dialog</button>
	<dialog id="example-dialog" aria-labelledby="dialog-title" aria-describedby="dialog-description">
		<h2 id="dialog-title">Example confirmation</h2>
		<p id="dialog-description">This dialog does not change any data.</p>
		<form method="dialog"><button autofocus>Close dialog</button></form>
	</dialog>
</section>
@section Scripts {
	<script src="~/js/components.js" asp-append-version="true"></script>
}
