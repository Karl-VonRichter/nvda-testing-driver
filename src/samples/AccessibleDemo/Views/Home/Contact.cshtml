@{
	ViewData["Title"] = "Contact";
}
<h1>@ViewData["Title"]</h1>
<h3><a href="#" data-bs-toggle="collapse" data-bs-target="#contactPhone" aria-expanded="false">Contact by phone</a></h3>
<div id="contactPhone" class="collapse">
	<p>Call us at +1 202 555 0100.</p>
</div>
<h3><a href="#" data-bs-toggle="collapse" data-bs-target="#contactEmail" aria-expanded="false">Contact by e-mail</a></h3>
<div id="contactEmail" class="collapse">
	<p>Write us an e-mail to <a href="mailto:info@@example.com">info@example.com</a></p>
</div>
<h3><a href="#" data-bs-toggle="collapse" data-bs-target="#contactAddress" aria-expanded="false">Postal address</a></h3>
<div id="contactAddress" class="collapse">
	<address>
		123 Example Street<br />
		Example City<br />
		<abbr title="Phone">P:</abbr>
		+1 202 555 0100
	</address>
</div>
<h3><a href="#" data-bs-toggle="collapse" data-bs-target="#contactForm" aria-expanded="false">Fill the contact form</a></h3>
<div id="contactForm" class="collapse">
<form>
	<div class="form-group">
		<label for="name" class="control-label">Name:</label>
		<input type="text" id="name" class="form-control" />
	</div>
	<div class="form-group">
		<label for="email" class="control-label">E-mail:</label>
		<input type="email" id="email" class="form-control" />
	</div>
	<div class="form-group">
		<button type="submit" class="btn btn-primary">Submit</button>
	</div>
</form>
	</div>